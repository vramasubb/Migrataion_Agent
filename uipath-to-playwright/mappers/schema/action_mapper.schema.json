{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_mapper.schema.json",
  "title": "UiPath to Playwright Action Mapper",
  "type": "object",
  "required": ["schemaVersion", "engines"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "engines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["excludeSubtree", "actions"],
        "properties": {
          "excludeSubtree": { "type": "array", "items": { "type": "string" } },
          "noOpTags": { "type": "array", "items": { "type": "string" } },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "standardActionType", "objectType", "tag", "valueTemplate"]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
